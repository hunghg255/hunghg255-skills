  }

  /* Main composition: camera wrapper for push-in at Beat 3 */
  .camera {
    position: absolute;
    inset: 0;
    transform-origin: 1000px 940px; /* center of Fix first-row */
    will-change: transform;
  }

  /* ============ LEFT: under-review artwork ============ */
  .subject {
    position: absolute;
    left: 150px;

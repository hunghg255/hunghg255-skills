    background: var(--accent);
    will-change: width;
  }
  .brand-tag {
    margin-top: 22px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.32em;
    color: rgba(26,25,24,0.54);
    text-transform: uppercase;
    opacity: 0;
    will-change: opacity;
  }
</style>
</head>

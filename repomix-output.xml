    opacity: 0.9;
    margin-bottom: 3px;
  }

  /* Finger / tap */
  .tap {
    position: absolute;
    z-index: 40;
    width: 64px; height: 64px;
    pointer-events: none;
    opacity: 0;
    will-change: opacity, transform;
  }
  .tap .core {
    position: absolute;
    inset: 18px;
    background: rgba(217, 119, 87, 0.85);
    border-radius: 50%;

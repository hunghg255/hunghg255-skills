  .cell .glyph {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .cell .name {
    position: relative;
    font-family: var(--mono);
    font-size: 11px;

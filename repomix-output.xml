    will-change: opacity;
  }
</style>
</head>
<body>

<div class="stage" id="stage">

  <!-- 水印 -->
  <div class="watermark-tl">HUASHU · DESIGN</div>
  <div class="watermark-br">V2 · 2026 · w3</div>

  <!-- Top title -->
  <div class="top-title" id="topTitle">
    Don't know what you want?<span class="accent">Here are 3 directions first</span>
  </div>
  <div class="sub-caption" id="subCaption">20 Philosophies · 3 Directions</div>

  <!-- 扫描光 -->
  <div class="scan-light" id="scanLight"></div>

  <!-- 4×5 Philosophy Wall -->
  <div class="wall-viewport" id="wallViewport">
    <div class="wall-grid" id="wallGrid">
      <!-- 20 cells injected by JS -->
    </div>
  </div>

  <!-- Foreground 3 direction cards -->
  <div class="fg-row" id="fgRow">
    <!-- card 1: Kenya Hara · Eastern minimalism -->
    <div class="fg-card" id="card1">
      <div class="card-body">
        <div class="label">Direction 01 · Eastern space</div>
        <div class="title-cn">Kenya Hara style whitespace</div>
        <div class="title-en">Kenya Hara</div>
        <div class="feature">Terracotta orange · Generous whitespace · Rice paper texture</div>
      </div>
      <div class="thumb-wrap" id="thumb1">
        <img src="demo-takram.png" alt="demo takram" />
      </div>
    </div>
    <!-- card 2: Pentagram · Information architecture -->
    <div class="fg-card" id="card2">
      <div class="card-body">
        <div class="label">Direction 02 · Information architecture</div>
        <div class="title-cn">Pentagram order</div>
        <div class="title-en">Pentagram</div>
        <div class="feature">Strong grid · High contrast · Rational layout</div>
      </div>
      <div class="thumb-wrap" id="thumb2">
        <img src="demo-pentagram.png" alt="demo pentagram" />
      </div>
    </div>
    <!-- card 3: David Carson · Experimental pioneer -->
    <div class="fg-card" id="card3">
      <div class="card-body">
        <div class="label">Direction 03 · Experimental pioneer</div>
        <div class="title-cn">David Carson style</div>
        <div class="title-en">Experimental Edge</div>
        <div class="feature">Breaking typography · Raw geometry · Visual impact</div>
      </div>
      <div class="thumb-wrap" id="thumb3">
        <img src="demo-build.png" alt="demo build" />
      </div>
    </div>
  </div>

  <!-- Brand Reveal -->
  <div class="brand-panel" id="brandPanel">

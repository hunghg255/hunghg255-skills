  /* 2. Home screen — Home · pomodoro */
  .home-screen { padding: 40px 28px; color: var(--cd-ink); }
  .home-screen .kicker {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.22em;

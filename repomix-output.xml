    margin-top: 30px;
    font-family: var(--serif-cn);
    font-size: 18px;
    font-weight: 300;
    color: var(--cd-dim);
    letter-spacing: 0.4em;
    opacity: 0;
    will-change: opacity;
  }
</style>

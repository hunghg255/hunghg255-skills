    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Header */
  .label {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: #B0ACA4;
    margin-bottom: 32px;
  }
  .title {
    font-size: 36px;
    font-weight: 200;
    line-height: 1.35;
    color: #1A1A1A;
    letter-spacing: -0.5px;
    max-width: 680px;
  }
  .title strong {
    font-weight: 500;
  }


  }
  .tap .ring {
    position: absolute;
    inset: 0;
    border: 2px solid rgba(217,119,87,0.6);
    border-radius: 50%;
    animation: tapring 0.6s ease-out;
  }
  @keyframes tapring {
    0% { transform: scale(0.4); opacity: 1; }
    100% { transform: scale(1.3); opacity: 0; }
